<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GPRStrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Theme.GPRStest.NoActionBar" parent ="MapTransparentActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:statusBarColor">@color/blue</item>
    </style>

    <style name="Theme.GPRStest.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.GPRStest.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.transparentActionBar" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">#2764DC</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="fontFamily">@font/fjallaoneregular</item>
        <item name="windowNoTitle">true</item>
    </style>
    <!--style pour les boutons floating-->
    <style name="custom_floating_buttons">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/custom_floating_button</item>
        <item name="fontFamily">@font/fjallaoneregular</item>
    </style>
    <style name="MapTransparentActionBar" >
        <item name="android:textColorPrimary">#673AB7</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="fontFamily">@font/fjallaoneregular</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.thepopup" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="ItemTextAppearance">
        <item name="android:textColor">#2196F3</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/fjallaoneregular</item>
        <item name="android:typeface">monospace</item>
    </style>

    <style name="navigationTheme">
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorControlHighlight">@color/purple_500</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
</resources>