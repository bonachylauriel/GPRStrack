<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashScreenActivity">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splashimage"
        android:layout_width="400dp"
        android:layout_height="331dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.19"
        app:lottie_rawRes="@raw/splashmarker"
        app:lottie_autoPlay="true">
    </com.airbnb.lottie.LottieAnimationView>
    <TextView
        android:id="@+id/textSplash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/splashimage"
        android:textColor="@color/blue"
        android:text="@string/splash_text"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/SoustextSplash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/textSplash"
        android:textColor="@color/blue"
        android:text="@string/splash_sous_text"
        android:textSize="14sp"
        android:textStyle="italic"/>

</androidx.constraintlayout.widget.ConstraintLayout>