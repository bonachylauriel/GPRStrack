<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <ImageView
                android:id="@+id/onlineImageView"
                android:layout_width="16dp"
                android:layout_height="50dp"
                android:layout_marginStart="9dp"
                android:layout_marginTop="0dp"
                android:paddingBottom="6dp"
                android:src="@drawable/button_green" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/checkbox"
                android:layout_alignBottom="@+id/checkbox"
                android:layout_alignParentTop="false"
                android:layout_toLeftOf="@+id/onlineImageView"
                android:layout_toEndOf="@+id/checkbox"
                android:textAllCaps="true"
                android:lines="1"
                android:gravity="center"
                android:text="New Text"
                android:textColor="#202020"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/title"
                android:layout_alignEnd="@+id/onlineImageView"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="30dp"
                android:layout_marginTop="-15dp"
                android:layout_marginEnd="68dp"
                android:text="dskfghfghfgh"
                android:textColor="#000000" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center|end"
                android:layout_marginStart="28dp"
                android:layout_marginTop="0dp"
                android:textColor="#0A1E91" />

            <ImageView
                android:id="@+id/gear"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="10dp"
                android:adjustViewBounds="false"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_more_vert_24" />

            <TextView
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/gear"
                android:layout_marginTop="-9dp"
                android:layout_marginEnd="115dp"
                android:layout_marginBottom="-9dp"
                android:layout_toStartOf="@+id/gear"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="New Text"
                android:textColor="#C10606" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/additionalLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/box_border"
            android:paddingStart="40dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/altitude"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:text="@string/altitude"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/altitudeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="40dp"
                android:layout_toEndOf="@+id/altitude"
                android:text="New Text"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/protocol"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/altitude"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:text="@string/protocol"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/protocolValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/altitude"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_toEndOf="@+id/protocol"
                android:text="New Text"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/driver"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/protocol"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:text="@string/driver"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/driverValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/protocol"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_toEndOf="@+id/protocol"
                android:text="New Text"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/position"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/driver"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:text="@string/position"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/positionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/driver"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_toEndOf="@+id/position"
                android:text="New Text"
                android:textColor="#000000" />

            <ImageView
                android:id="@+id/info"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_below="@+id/position"
                android:layout_marginTop="10dp"
                android:background="@drawable/grey_round_stroke"
                android:padding="8dp"
                android:src="@drawable/info_off" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>