<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:id="@+id/layout_balises"
    android:theme="@style/Theme.GPRStrack"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:background="@color/purple_500"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/id_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4sp"
            android:textAlignment="center"
            android:gravity="center"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/backLeft"
            android:layout_width="48sp"
            android:layout_height="48sp"
            android:background="@color/black_overlay"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0sp"
            android:gravity="end"
            android:src="@drawable/ic_baseline_close_24"
            tools:ignore="ContentDescription" />
    </LinearLayout>
    <View
        android:id="@+id/view1"
        android:layout_below="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_marginTop="5sp"
        android:background="#e1dfdf"
        android:layout_height="1dp"/>

    <EditText
        android:id="@+id/searchObject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/view1"
        android:hint="@string/recherches"
        android:importantForAutofill="no"
        android:inputType="text"
        android:labelFor="@id/searchObject"
        android:lines="1"
        android:minHeight="48dp"
        android:textColor="@color/blue"
        android:textSize="14sp"
        android:textStyle="bold" />
    <View
        android:id="@+id/view2"
        android:layout_marginTop="5sp"
        android:layout_below="@+id/searchObject"
        android:layout_width="match_parent"
        android:background="#e1dfdf"
        android:layout_height="1dp"/>

   <ExpandableListView
       android:id="@+id/expandable_listview_balises52"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@color/white"
       android:layout_below="@id/view2"
       android:divider="@color/black"
       android:groupIndicator="@null"
       android:indicatorLeft="?android:attr/expandableListPreferredItemIndicatorLeft"
       android:choiceMode="singleChoice">
   </ExpandableListView>

    <RelativeLayout
        android:id="@+id/rien_a_voir2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff"
        android:layout_below="@id/view2"
        android:visibility="gone"
        android:gravity="center">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/aucune_balise"/>
    </RelativeLayout>

</RelativeLayout>